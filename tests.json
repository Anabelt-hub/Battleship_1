{
    "team_name": "Team 404 Error",
    "api_version": "2.3",
    "tests": [
      {
        "name": "Standard Player Registration",
        "why": "Verifies that a valid username returns 201 and a server-generated integer ID.",
        "method": "POST",
        "endpoint": "/api/players",
        "headers": {},
        "body": {
          "username": "Admiral_Gabbie"
        },
        "expected_status": 201,
        "expected_response_contains": {
          "player_id": "__any_integer__"
        },
        "requires": "clean"
      },
      {
        "name": "Game Creation Initial Status",
        "why": "Ensures new games correctly initialize in the waiting_setup state per v2.3 spec.",
        "method": "POST",
        "endpoint": "/api/games",
        "headers": {},
        "body": {
          "creator_id": 1,
          "grid_size": 10,
          "max_players": 2
        },
        "expected_status": 201,
        "expected_response_contains": {
          "game_id": "__any_integer__",
          "status": "waiting_setup"
        },
        "requires": "clean"
      },
      {
        "name": "Join Existing Lobby",
        "why": "Confirms a second player can join a created game successfully.",
        "method": "POST",
        "endpoint": "/api/games/{id}/join",
        "headers": {},
        "body": {
          "player_id": 2
        },
        "expected_status": 200,
        "expected_response_contains": {
          "status": "joined"
        },
        "requires": "game_created"
      },
      {
        "name": "Reject Out of Turn Fire",
        "why": "Enforces turn order by rejecting Player 2's fire attempt before Player 1 has moved.",
        "method": "POST",
        "endpoint": "/api/games/{id}/fire",
        "headers": {},
        "body": {
          "player_id": 2,
          "row": 0,
          "col": 0
        },
        "expected_status": 403,
        "expected_response_contains": {
          "error": "forbidden"
        },
        "requires": "game_playing"
      },
      {
        "name": "Coordinate Bounds Validation",
        "why": "Ensures the server rejects fire attempts outside the defined grid dimensions.",
        "method": "POST",
        "endpoint": "/api/games/{id}/fire",
        "headers": {},
        "body": {
          "player_id": 1,
          "row": 99,
          "col": 5
        },
        "expected_status": 400,
        "expected_response_contains": {
          "error": "bad_request"
        },
        "requires": "game_playing"
      },
      {
        "name": "Duplicate Move Prevention",
        "why": "Verifies that the server prevents a player from targeting the same sector twice in one game.",
        "method": "POST",
        "endpoint": "/api/games/{id}/fire",
        "headers": {},
        "body": {
          "player_id": 1,
          "row": 5,
          "col": 5
        },
        "expected_status": 409,
        "expected_response_contains": {
          "error": "conflict"
        },
        "requires": "game_playing"
      },
      {
        "name": "Player Stats Integrity",
        "why": "Ensures the stats endpoint returns the correct structure and zero-state for a registered player.",
        "method": "GET",
        "endpoint": "/api/players/1/stats",
        "headers": {},
        "body": null,
        "expected_status": 200,
        "expected_response_contains": {
          "player_id": "__any_integer__",
          "wins": 0,
          "accuracy": 0.0
        },
        "requires": "clean"
      }
    ]
  }